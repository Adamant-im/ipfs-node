// Standalone evaluation configuration for the Docker Compose stack.
//
//   cp config.example.json5 config.json5
//
// It joins no existing network: `nodes` and `peerDiscovery.bootstrap` are
// empty, so this node peers with nobody and stores one local copy of everything
// it accepts. Add the peers of your own deployment before relying on
// replication, and read
// https://ipfs-node.docs.adamant.im/guide/configuration first.
{
  // Peers this node replicates with and keeps connections to. Every entry needs
  // a multiaddr ending in /p2p/<peer-id>. Leave empty for a single node.
  nodes: [],

  // Resolved from the home directory of the process user. The image pins
  // HOME=/data, so this is /data/.adm-ipfs inside the container and lives on
  // the `ipfs-node-data` volume.
  storeFolder: '.adm-ipfs',

  logLevel: 'info',
  // Production logs are newline-delimited JSON. Enable this only for a local
  // terminal; a log collector wants the structured fields.
  prettyLogs: false,

  peerDiscovery: {
    // Dialled once at startup. Use the same peers as `nodes` for a real mesh.
    bootstrap: [],
    listen: ['/ip4/0.0.0.0/tcp/4001']
  },

  serverPort: 4000,
  diskUsageScanPeriod: '*/30 * * * * *',
  // Redials the peers in `nodes` that are not connected. Bootstrap dials once
  // and never again, so a mesh without this never recovers from a restart.
  peeringSchedule: '*/30 * * * * *',

  uploadLimitSizeBytes: 268435456, // 256 MiB per file
  maxFileCount: 10,
  findFileTimeout: 20000,
  downloadIdleTimeout: 20000,
  downloadMinBytesPerSecond: 32768,
  downloadMaxDurationMs: 14400000, // 4 h absolute ceiling for one response

  cors: {
    // Exact origins and any-depth subdomain wildcards. Replace these with the
    // origins of your own application; `*` is rejected.
    allowedOrigins: ['http://localhost:8080']
  },

  // Keep false when clients connect directly. Behind a reverse proxy, list the
  // exact proxy addresses or CIDR ranges instead.
  trustProxy: false,

  rateLimits: {
    upload: { windowMs: 900000, limit: 10 },
    pin: { windowMs: 900000, limit: 10 },
    read: { windowMs: 60000, limit: 100 }
  },

  // Generate with: openssl rand -hex 32
  // Administrative routes answer 503 while this is empty, which is the safe
  // default for an evaluation node. Mount a real secret before using them.
  adminApiKey: '',

  // The debug API is not mounted unless this is true; it still needs the key.
  enableDebugApi: false,

  storage: {
    maxRequestSizeBytes: 536870912, // 512 MiB combined per request
    maxConcurrentUploads: 32,
    maxConcurrentDownloads: 64,
    maxConcurrentDownloadsPerClient: 8,
    // Free space uploads must never consume. Lower it only on a small
    // evaluation volume, and never below what one accepted request can write.
    diskReserveBytes: 1073741824, // 1 GiB
    confirmationRequired: false,
    temporaryTtlMs: 86400000,
    gc: {
      enabled: true,
      schedule: '0 */15 * * * *',
      highWatermarkBytes: 10737418240, // 10 GiB
      lowWatermarkBytes: 8589934592 // 8 GiB
    }
  },

  replication: {
    // A single node has no peers to place copies on, so every file stays in one
    // copy here. Add peers to `nodes` before this promises anything.
    enabled: true,
    placement: [
      { minAgeMs: 0, copies: 4 },
      { minAgeMs: 15552000000, copies: 3 },
      { minAgeMs: 31536000000, copies: 2 }
    ],
    ackQuorum: 1,
    requireQuorumOnUpload: false,
    requestTimeoutMs: 30000,
    repairEnabled: true,
    repairSchedule: '0 */30 * * * *',
    repairBatchDelayMs: 1000,
    repairProbeConcurrency: 4
  },

  health: {
    checkpointIntervalMs: 60000,
    maxCheckpointAgeMs: 180000,
    storageMaxAgeMs: 120000,
    repairMaxAgeMs: 3600000,
    clockSkewToleranceMs: 10000,
    // Must not exceed the number of configured remote peers, so a single node
    // has to keep this at 0. Raise it once every required peer is upgraded.
    requiredPeerCount: 0,
    // Consecutive complete unsuccessful repair cycles with backlog during which
    // repairFresh stays true. 0 is strict: any backlog fails the checkpoint.
    repairBacklogGraceCycles: 0
  }
}
