// Configuration used by `npm test`. Selected through IPFS_NODE_CONFIG=test.
// It must not reach the network: no bootstrap peers and no known nodes.
{
  nodes: [],
  storeFolder: '.adm-ipfs-test',
  logLevel: 'silent',
  peerDiscovery: {
    bootstrap: [],
    // Port 0 lets the OS pick a free port so tests never clash with a running node
    listen: ['/ip4/127.0.0.1/tcp/0']
  },
  serverPort: 4000,
  diskUsageScanPeriod: '*/30 * * * * *',
  uploadLimitSizeBytes: 268435456, // 256 Mb.
  maxFileCount: 10,
  findFileTimeout: 20000,
  cors: {
    allowedOrigins: ['http://localhost:8080']
  },
  trustProxy: false,
  rateLimits: {
    upload: { windowMs: 900000, limit: 10 },
    pin: { windowMs: 900000, limit: 10 },
    read: { windowMs: 60000, limit: 100 }
  },
  adminApiKey: '',
  enableDebugApi: false,
  storage: {
    maxRequestSizeBytes: 536870912,
    maxConcurrentUploads: 2,
    diskReserveBytes: 1048576,
    confirmationRequired: false,
    temporaryTtlMs: 3600000,
    gc: {
      enabled: false,
      schedule: '0 */15 * * * *',
      highWatermarkBytes: 10485760,
      lowWatermarkBytes: 5242880
    }
  },
  replication: {
    enabled: false,
    placement: [
      { minAgeMs: 0, copies: 3 },
      { minAgeMs: 31536000000, copies: 2 }
    ],
    ackQuorum: 1,
    requireQuorumOnUpload: false,
    requestTimeoutMs: 5000,
    repairEnabled: false,
    repairSchedule: '0 */30 * * * *'
  }
}
