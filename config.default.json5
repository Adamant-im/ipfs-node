  trustProxy: false,
  rateLimits: {
    upload: { windowMs: 900000, limit: 10 },
    pin: { windowMs: 900000, limit: 10 },
    read: { windowMs: 60000, limit: 100 }
  },
  // Generate with: openssl rand -hex 32
  // Admin routes return 503 while this value is empty.
  adminApiKey: '',
  // The debug API is absent unless explicitly enabled; it still requires the admin key.
  enableDebugApi: false
