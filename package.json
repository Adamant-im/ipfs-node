{
  "name": "ipfs-node",
  "version": "0.0.1",
  "description": "IPFS decentralized file storage and transfers",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "dev": "nodemon",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "npm run build && npm run test:unit && npm run test:integration",
    "test:unit": "IPFS_NODE_CONFIG=test node --test \"dist/test/unit/*.test.js\"",
    "test:integration": "IPFS_NODE_CONFIG=test node --test \"dist/test/integration/*.test.js\"",
    "prepare": "husky",
    "bump-patch": "npm version patch",
    "bump-minor": "npm version minor",
    "bump-major": "npm version major"
  },
  "author": "ADAMANT Foundation <devs@adamant.im>",
  "license": "GPLv3",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@helia/bitswap": "^4.0.12",
    "@helia/libp2p": "^2.1.1",
    "@helia/unixfs": "^8.0.5",
    "@libp2p/bootstrap": "^12.0.29",
    "@libp2p/identify": "^4.1.12",
    "@libp2p/interface": "^3.2.5",
    "@libp2p/peer-id": "^6.0.14",
    "@libp2p/ping": "^3.1.11",
    "@libp2p/tcp": "^11.0.26",
    "@multiformats/multiaddr": "^13.0.3",
    "blockstore-fs": "^4.0.1",
    "cors": "^2.8.6",
    "cron": "^4.4.0",
    "datastore-fs": "^12.0.1",
    "express": "^4.22.2",
    "helia": "^7.1.8",
    "interface-blockstore": "^7.0.1",
    "interface-datastore": "^10.0.1",
    "json5": "^2.2.3",
    "multer": "^2.2.0",
    "multiformats": "^14.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3"
  },
  "lint-staged": {
    "*.(ts|js)": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
