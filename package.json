{
  "name": "ipfs-node",
  "version": "0.0.1",
  "description": "IPFS decentralized file storage and transfers",
  "main": "dist/index.js",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rimraf dist && tsc",
    "start": "node dist/index.js",
    "dev": "nodemon",
    "lint": "eslint src test scripts --ext .ts,.mjs",
    "test:build": "rimraf dist-test && tsc -p tsconfig.test.json",
    "test": "npm run test:build && node --test dist-test/test/*.test.js",
    "prepare": "husky",
    "bump-patch": "npm version patch",
    "bump-minor": "npm version minor",
    "bump-major": "npm version major",
    "security:audit": "node scripts/audit-production.mjs",
    "security:audit:raw": "npm audit --omit=dev --omit=peer --audit-level=high",
    "security:audit:full": "npm audit --omit=dev --omit=peer --json > npm-audit-report.json",
    "security:semgrep": "semgrep --config p/owasp-top-ten --config p/nodejs --config p/expressjs --config p/typescript --config .semgrep/rules.yml --no-strict src/"
  },
  "author": "ADAMANT Foundation <devs@adamant.im>",
  "license": "GPLv3",
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.8",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "eslint": "^8.57.0",
    "gts": "^5.3.1",
    "husky": "^9.1.4",
    "lint-staged": "^15.2.8",
    "nodemon": "^3.1.4",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@chainsafe/libp2p-noise": "^15.1.0",
    "@chainsafe/libp2p-yamux": "^6.0.2",
    "@helia/unixfs": "^3.0.7",
    "@libp2p/bootstrap": "^10.1.4",
    "@libp2p/identify": "^2.1.5",
    "@libp2p/interface": "^1.7.0",
    "@libp2p/peer-id": "^4.2.3",
    "@libp2p/ping": "^1.1.6",
    "@libp2p/tcp": "^9.1.4",
    "@multiformats/multiaddr": "^12.5.1",
    "blockstore-fs": "^1.1.11",
    "cors": "^2.8.5",
    "cron": "^3.1.7",
    "datastore-fs": "^9.1.9",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "go-get-folder-size": "^0.5.5",
    "helia": "^4.2.5",
    "json5": "^2.2.3",
    "multer": "^2.2.0",
    "multiformats": "^13.2.2",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0"
  },
  "lint-staged": {
    "*.(ts|js)": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
